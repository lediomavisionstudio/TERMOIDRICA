# Resend — invio email del form preventivo (https://resend.com)
# 1. Crea un account gratuito su resend.com (3000 email/mese)
# 2. Crea una API key e incollala qui
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Mittente: deve usare un dominio VERIFICATO su Resend.
# Per i test puoi lasciare onboarding@resend.dev; in produzione verifica
# termoidricags.it su Resend e usa es. "Termoidrica GS <sito@termoidricags.it>"
RESEND_FROM="Termoidrica GS <onboarding@resend.dev>"

# Destinatario delle richieste (dove arrivano i preventivi).
# Se non impostato, usa l'email in lib/data.ts (Termoidricags@gmail.com)
PREVENTIVO_TO=Termoidricags@gmail.com
